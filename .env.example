# ─────────────────────────────────────────────────────────────
# ZaviksTech — Environment Variables
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/zaviks_tech?schema=public"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Admin bootstrap credentials (used by the seed script)
ADMIN_EMAIL="admin@zavikstech.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Resend (transactional email)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender domain in Resend
EMAIL_FROM="ZaviksTech <no-reply@zavikstech.com>"
# Internal inbox that receives new-lead notifications
LEAD_NOTIFICATION_EMAIL="contact@zavikstech.com"

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://zavikstech.com"

# Public contact details (rendered in UI)
NEXT_PUBLIC_CONTACT_PHONE="+44 7862 714552"
NEXT_PUBLIC_WHATSAPP_NUMBER="447862714552"
NEXT_PUBLIC_CONTACT_EMAIL="contact@zavikstech.com"
